# Shared environment template. Copy to .env and replace all placeholders.
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27017/kisan_sahayak?replicaSet=rs0
SESSION_SECRET=YYUUII66778899667788777788889977
SESSION_NAME=ks.sid
COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional email / SMS / maps / object-storage integrations are intentionally not simulated.
MAPS_API_KEY=
SMTP_URL=
SMS_PROVIDER_API_KEY=
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
